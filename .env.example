# Copy to .env.local and fill in from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public origin used to build auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini (AI Studio) key used to parse uploaded resumes.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override. Defaults to gemini-3.8-flash.
GEMINI_MODEL=
